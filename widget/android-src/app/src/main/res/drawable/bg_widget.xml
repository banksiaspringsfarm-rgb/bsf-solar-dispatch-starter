<?xml version="1.0" encoding="utf-8"?>
<!-- BSF Solar widget v3 — card background. Colours come from @color so the
     same drawable serves both themes: light (values/) and dark navy/charcoal
     (values-night/). Replaces v2's hard-coded bg_widget_light. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/w_card_bg" />
    <corners android:radius="20dp" />
    <stroke android:width="1dp" android:color="@color/w_card_border" />
</shape>
