#cloud-config
hostname: __HOSTNAME__
manage_etc_hosts: true
timezone: Australia/Brisbane
users:
- name: bsf
  groups: users,adm,dialout,audio,netdev,video,plugdev,sudo,gpio,i2c,spi
  shell: /bin/bash
  lock_passwd: false
  passwd: "__SHA512_CRYPT_HASH__"
  ssh_authorized_keys:
  - "__YOUR_SSH_PUBLIC_KEY__"
  sudo: ALL=(ALL) NOPASSWD:ALL
ssh_pwauth: true
enable_ssh: true
package_update: true
packages:
- git
- mosquitto
- mosquitto-clients
- python3-pip
- python3-venv
- curl
runcmd:
- [sh, -c, "curl -fsSL https://tailscale.com/install.sh | sh"]
- [systemctl, enable, --now, mosquitto]
- [sh, -c, "printf 'listener 1883\nallow_anonymous true\nlistener 9001\nprotocol websockets\nallow_anonymous true\n' > /etc/mosquitto/conf.d/lan.conf && systemctl restart mosquitto"]
- [sh, -c, "curl -fsSL https://raw.githubusercontent.com/node-red/linux-installers/master/deb/update-nodejs-and-nodered -o /home/bsf/nr.sh && chown bsf:bsf /home/bsf/nr.sh"]
- [sudo, -u, bsf, bash, /home/bsf/nr.sh, --confirm-install, --confirm-pi, --skip-pi, --no-init, --node22]
- [sudo, -u, bsf, bash, -c, "mkdir -p /home/bsf/.node-red && cd /home/bsf/.node-red && npm i --no-audit --no-fund node-red-contrib-tuya-smart-device"]
- [systemctl, enable, --now, nodered]
- [sudo, -u, bsf, bash, -c, "cd /home/bsf && git clone --depth 1 https://github.com/banksiaspringsfarm-rgb/bsf-solar-dispatch-starter.git && python3 -m venv /home/bsf/.venv-bsf && /home/bsf/.venv-bsf/bin/pip -q install -r /home/bsf/bsf-solar-dispatch-starter/publisher/requirements.txt"]
- [sh, -c, "sync && touch /home/bsf/FIRSTBOOT_DONE && chown bsf:bsf /home/bsf/FIRSTBOOT_DONE"]
